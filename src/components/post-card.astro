---
import { formatDate, postMinutes, tagSlug, type Post } from '../lib/posts';
import { series, site } from '../lib/site';
const { post } = Astro.props as { post: Post };
const d = post.data;
const href = `/${post.id}`;
---
<article class="card">
  {d.image && <a class="card-cover" href={href} tabindex="-1" aria-hidden="true"><img src={d.image} alt="" loading="lazy" /></a>}
  <div class="card-body">
    <div class="chips">
      {d.series && <a class="chip series" href={`/series/${d.series}`}>{series[d.series]?.title ?? d.series}</a>}
      {d.categories.slice(0, 2).map((c) => <a class="chip" href={`/tags/${tagSlug(c)}`}>{c}</a>)}
    </div>
    <h3><a href={href}>{d.title}</a></h3>
    {d.description && <p>{d.description}</p>}
  </div>
  <footer class="card-foot">
    <img class="avatar" src="/logo.png" alt="" />
    <div>
      <div class="who">{site.name}</div>
      <div class="meta"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> · {postMinutes(post)} phút đọc</div>
    </div>
  </footer>
</article>
