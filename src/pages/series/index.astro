---
import Base from '../../layouts/base-layout.astro';
import { getPosts, inSeries } from '../../lib/posts';
import { series } from '../../lib/site';
const all = await getPosts();
const cards = Object.entries(series).map(([id, s]) => ({ id, ...s, have: inSeries(all, id).length, total: s.parts?.length ?? inSeries(all, id).length }));
---
<Base title="Series">
  <div class="wrap">
    <h1 class="page-title">Series</h1>
    <p class="lead">Các chuỗi bài đọc theo thứ tự.</p>
    <div class="series-grid">
      {cards.map((c) => (
        <a class="series-card" href={`/series/${c.id}`}>
          <span class="kicker">{c.have}/{c.total} bài</span>
          <h3>{c.title}</h3>
          <p>{c.description}</p>
          <div class="progress" aria-hidden="true"><i style={`width:${(c.have / c.total) * 100}%`}></i></div>
        </a>
      ))}
    </div>
  </div>
</Base>
