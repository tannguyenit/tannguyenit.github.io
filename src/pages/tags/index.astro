---
import Base from '../../layouts/base-layout.astro';
import { getPosts, listed, tagSlug } from '../../lib/posts';
const posts = listed(await getPosts());
const counts = new Map<string, number>();
posts.forEach((p) => p.data.categories.forEach((c) => counts.set(c, (counts.get(c) ?? 0) + 1)));
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Chủ đề">
  <div class="wrap">
    <h1 class="page-title">Chủ đề</h1>
    <p class="lead">Bấm vào một chủ đề để xem các bài liên quan.</p>
    <div class="tag-cloud">
      {tags.map(([t, n]) => <a class="chip" href={`/tags/${tagSlug(t)}`}>{t} · {n}</a>)}
    </div>
  </div>
</Base>
